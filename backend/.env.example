# ==========================================
# Matty Backend Environment Variables
# ==========================================

# Server Port (Render sets this automatically)
PORT=8080

# MongoDB Connection URI
# e.g., mongodb+srv://<username>:<password>@<cluster>.mongodb.net/matty?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ki7twvk.mongodb.net/matty?retryWrites=true&w=majority

# JWT Secret (Base64-encoded 256-bit or 512-bit HMAC key)
JWT_SECRET=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNA==
JWT_EXPIRATION=604800000

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS - Comma-separated list of allowed frontend origins (no trailing slashes)
# In development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://matty-design-tau.vercel.app
# In production (Render dashboard):
# ALLOWED_ORIGINS=https://matty-design-tau.vercel.app

# Frontend OAuth2 Redirect URI (where backend redirects after successful OAuth login)
# In development:
APP_OAUTH2_AUTHORIZED_REDIRECT_URI=http://localhost:5173/oauth2/redirect
# In production (Render dashboard):
# APP_OAUTH2_AUTHORIZED_REDIRECT_URI=https://matty-design-tau.vercel.app/oauth2/redirect

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth Client ID (Web application)
# Authorized JavaScript origins in Google Console:
# Development: http://localhost:8080, http://localhost:5173
# Production:  https://matty-smxu.onrender.com, https://matty-design-tau.vercel.app
# Authorized redirect URI in Google Console:
# Development: http://localhost:8080/login/oauth2/code/google
# Production:  https://matty-smxu.onrender.com/login/oauth2/code/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth App Credentials
# Obtain from GitHub Settings -> Developer settings -> OAuth Apps -> New OAuth App
# Authorization callback URL in GitHub:
# Development: http://localhost:8080/login/oauth2/code/github
# Production:  https://<your-render-backend-url>/login/oauth2/code/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
